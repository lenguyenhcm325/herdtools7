Het 2+2W-cg-gpu-release
"Heterogeneous 2+2W-cg-gpu-release: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X1=x;
0:X3=y;
}
 P0:cpu      | P1:gpu             ;
 MOV W0,#2   | w[release,gpu] y 2 ;
 STR W0,[X1] | w[release,gpu] x 1 ;
 MOV W2,#1   |                    ;
 STR W2,[X3] |                    ;
exists ([x]=2 /\ [y]=2)
