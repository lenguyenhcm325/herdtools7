Het S-gc-sys-sy.ra-2s
"Heterogeneous S-gc-sys-sy.ra-2s: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA)"
{
1:X1=x;
1:X3=y;
}
 P0:gpu             | P1:cpu      ;
 w[release,sys] x 2 | LDR W0,[X3] ;
 w[release,sys] y 1 | DMB SY      ;
                    | MOV W2,#1   ;
                    | STR W2,[X1] ;
scopes: (sys (gpu (cta P0)))
exists (1:X0=1 /\ [x]=2)
