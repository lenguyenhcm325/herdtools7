Het CoRW2-cg-cta-release
"Heterogeneous CoRW2-cg-cta-release: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA)"
{
0:X0=x;
}
 P0:cpu      | P1:gpu             ;
 LDR W1,[X0] | w[release,cta] x 2 ;
 MOV W2,#1   |                    ;
 STR W2,[X0] |                    ;
scopes: (sys (gpu (cta P1)))
exists (0:X1=2 /\ [x]=2)
