Het CoRR-gc-sys-acquire
"Heterogeneous CoRR-gc-sys-acquire: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X0=x;
}
 P0:gpu              | P1:cpu      ;
 r[acquire,sys] r0 x | MOV W1,#1   ;
 r[acquire,sys] r1 x | STR W1,[X0] ;
scopes: (sys (gpu (cta P0)))
exists (0:r0=1 /\ 0:r1=0)
