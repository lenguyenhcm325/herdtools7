Het WRC-cgc-gpu-relaxed
"Heterogeneous WRC-cgc-gpu-relaxed: per-proc device assignment cpu,gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X0=x;
0:X3=y;
2:X0=x;
}
 P0:cpu      | P1:gpu              | P2:cpu      ;
 LDR W1,[X0] | r[relaxed,gpu] r0 y | MOV W1,#1   ;
 MOV W2,#1   | r[relaxed,gpu] r1 x | STR W1,[X0] ;
 STR W2,[X3] |                     |             ;
scopes: (sys (gpu (cta P1)))
exists (0:X1=1 /\ 1:r0=1 /\ 1:r1=0)
