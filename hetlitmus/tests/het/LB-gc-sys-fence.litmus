Het LB-gc-sys-fence
"Heterogeneous LB-gc-sys-fence: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X0=x;
1:X3=y;
}
 P0:gpu              | P1:cpu      ;
 r[relaxed,sys] r0 x | LDR W1,[X3] ;
 f[sc,sys]           | MOV W2,#1   ;
 w[relaxed,sys] y 1  | STR W2,[X0] ;
exists (0:r0=1 /\ 1:X1=1)
