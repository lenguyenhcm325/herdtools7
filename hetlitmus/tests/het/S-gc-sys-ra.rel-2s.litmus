Het S-gc-sys-ra.rel-2s
"Heterogeneous S-gc-sys-ra.rel-2s: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X1=x;
1:X3=y;
}
 P0:gpu             | P1:cpu        ;
 w[relaxed,sys] x 2 | LDAPR W0,[X3] ;
 f[release,sys]     | MOV W2,#1     ;
 w[relaxed,sys] y 1 | STLR W2,[X1]  ;
scopes: (sys (gpu (cta P0)))
exists (1:X0=1 /\ [x]=2)
