Het LB-gc-sys-acqrel-2s
"Heterogeneous LB-gc-sys-acqrel-2s: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X0=x;
1:X3=y;
}
 P0:gpu              | P1:cpu        ;
 r[acquire,sys] r0 x | LDAPR W1,[X3] ;
 w[release,sys] y 1  | MOV W2,#1     ;
                     | STLR W2,[X0]  ;
scopes: (sys (gpu (cta P0)))
exists (0:r0=1 /\ 1:X1=1)
