Het WRC-gcc-sys-acqrel-2s
"Heterogeneous WRC-gcc-sys-acqrel-2s: per-proc device assignment gpu,cpu,cpu (cpu=AArch64, gpu=LISA)"
{
1:X0=x;
1:X3=y;
2:X0=x;
}
 P0:gpu              | P1:cpu        | P2:cpu       ;
 r[acquire,sys] r0 x | LDAPR W1,[X3] | MOV W1,#1    ;
 w[release,sys] y 1  | LDAPR W2,[X0] | STLR W1,[X0] ;
scopes: (sys (gpu (cta P0)))
exists (0:r0=1 /\ 1:X1=1 /\ 1:X2=0)
