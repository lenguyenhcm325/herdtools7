Het RWC-cgc-sys-fence-2s
"Heterogeneous RWC-cgc-sys-fence-2s: per-proc device assignment cpu,gpu,cpu (cpu=AArch64, gpu=LISA)"
{
0:X0=x;
0:X2=y;
2:X0=x;
}
 P0:cpu      | P1:gpu              | P2:cpu      ;
 LDR W1,[X0] | w[relaxed,sys] y 1  | MOV W1,#1   ;
 DMB SY      | f[sc,sys]           | STR W1,[X0] ;
 LDR W3,[X2] | r[relaxed,sys] r0 x |             ;
scopes: (sys (gpu (cta P1)))
exists (0:X1=1 /\ 0:X3=0 /\ 1:r0=0)
