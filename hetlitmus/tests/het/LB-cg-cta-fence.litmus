Het LB-cg-cta-fence
"Heterogeneous LB-cg-cta-fence: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X0=x;
0:X3=y;
}
 P0:cpu      | P1:gpu              ;
 LDR W1,[X0] | r[relaxed,cta] r0 y ;
 MOV W2,#1   | f[sc,cta]           ;
 STR W2,[X3] | w[relaxed,cta] x 1  ;
scopes: (sys (gpu (cta P1)))
exists (0:X1=1 /\ 1:r0=1)
