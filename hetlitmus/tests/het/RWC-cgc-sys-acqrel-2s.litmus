Het RWC-cgc-sys-acqrel-2s
"Heterogeneous RWC-cgc-sys-acqrel-2s: per-proc device assignment cpu,gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X0=x;
0:X2=y;
2:X0=x;
}
 P0:cpu        | P1:gpu              | P2:cpu       ;
 LDAPR W1,[X0] | w[release,sys] y 1  | MOV W1,#1    ;
 LDAPR W3,[X2] | r[acquire,sys] r0 x | STLR W1,[X0] ;
scopes: (sys (gpu (cta P1)))
exists (0:X1=1 /\ 0:X3=0 /\ 1:r0=0)
