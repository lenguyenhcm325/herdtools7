Het SB-gc-cta-fence
"Heterogeneous SB-gc-cta-fence: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X1=x;
1:X2=y;
}
 P0:gpu              | P1:cpu      ;
 w[relaxed,cta] x 1  | MOV W0,#1   ;
 f[sc,cta]           | STR W0,[X2] ;
 r[relaxed,cta] r0 y | LDR W3,[X1] ;
scopes: (sys (gpu (cta P0)))
exists (0:r0=0 /\ 1:X3=0)
