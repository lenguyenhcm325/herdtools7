Het ISA2-gcc-gpu-fence
"Heterogeneous ISA2-gcc-gpu-fence: per-proc device assignment gpu,cpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X3=y;
1:X4=z;
2:X1=x;
2:X4=z;
}
 P0:gpu             | P1:cpu      | P2:cpu      ;
 w[relaxed,gpu] x 1 | LDR W0,[X3] | LDR W0,[X4] ;
 f[sc,gpu]          | MOV W2,#1   | LDR W2,[X1] ;
 w[relaxed,gpu] y 1 | STR W2,[X4] |             ;
exists (1:X0=1 /\ 2:X0=1 /\ 2:X2=0)
