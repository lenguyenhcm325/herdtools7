Het ISA2-cgc-cta-release
"Heterogeneous ISA2-cgc-cta-release: per-proc device assignment cpu,gpu,cpu (cpu=AArch64, gpu=LISA)"
{
0:X1=x;
0:X3=y;
2:X1=x;
2:X4=z;
}
 P0:cpu      | P1:gpu              | P2:cpu      ;
 MOV W0,#1   | r[relaxed,cta] r0 y | LDR W0,[X4] ;
 STR W0,[X1] | w[release,cta] z 1  | LDR W2,[X1] ;
 MOV W2,#1   |                     |             ;
 STR W2,[X3] |                     |             ;
scopes: (sys (gpu (cta P1)))
exists (1:r0=1 /\ 2:X0=1 /\ 2:X2=0)
