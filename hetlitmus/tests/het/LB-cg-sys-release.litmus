Het LB-cg-sys-release
"Heterogeneous LB-cg-sys-release: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X0=x;
0:X3=y;
}
 P0:cpu      | P1:gpu              ;
 LDR W1,[X0] | r[relaxed,sys] r0 y ;
 MOV W2,#1   | w[release,sys] x 1  ;
 STR W2,[X3] |                     ;
exists (0:X1=1 /\ 1:r0=1)
