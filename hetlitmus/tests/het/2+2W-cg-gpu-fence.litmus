Het 2+2W-cg-gpu-fence
"Heterogeneous 2+2W-cg-gpu-fence: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X1=x;
0:X3=y;
}
 P0:cpu      | P1:gpu             ;
 MOV W0,#2   | w[relaxed,gpu] y 2 ;
 STR W0,[X1] | f[sc,gpu]          ;
 MOV W2,#1   | w[relaxed,gpu] x 1 ;
 STR W2,[X3] |                    ;
exists ([x]=2 /\ [y]=2)
