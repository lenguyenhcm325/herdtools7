Het CoRW2-gc-gpu-release
"Heterogeneous CoRW2-gc-gpu-release: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X0=x;
}
 P0:gpu              | P1:cpu      ;
 r[relaxed,gpu] r0 x | MOV W1,#2   ;
 w[release,gpu] x 1  | STR W1,[X0] ;
scopes: (sys (gpu (cta P0)))
exists (0:r0=2 /\ [x]=2)
