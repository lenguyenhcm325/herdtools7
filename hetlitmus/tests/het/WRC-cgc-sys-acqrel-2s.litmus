Het WRC-cgc-sys-acqrel-2s
"Heterogeneous WRC-cgc-sys-acqrel-2s: per-proc device assignment cpu,gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X0=x;
0:X3=y;
2:X0=x;
}
 P0:cpu        | P1:gpu              | P2:cpu       ;
 LDAPR W1,[X0] | r[acquire,sys] r0 y | MOV W1,#1    ;
 MOV W2,#1     | r[acquire,sys] r1 x | STLR W1,[X0] ;
 STLR W2,[X3]  |                     |              ;
scopes: (sys (gpu (cta P1)))
exists (0:X1=1 /\ 1:r0=1 /\ 1:r1=0)
