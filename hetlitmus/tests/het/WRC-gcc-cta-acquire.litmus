Het WRC-gcc-cta-acquire
"Heterogeneous WRC-gcc-cta-acquire: per-proc device assignment gpu,cpu,cpu (cpu=AArch64, gpu=LISA)"
{
1:X0=x;
1:X3=y;
2:X0=x;
}
 P0:gpu              | P1:cpu      | P2:cpu      ;
 r[acquire,cta] r0 x | LDR W1,[X3] | MOV W1,#1   ;
 w[relaxed,cta] y 1  | LDR W2,[X0] | STR W1,[X0] ;
scopes: (sys (gpu (cta P0)))
exists (0:r0=1 /\ 1:X1=1 /\ 1:X2=0)
