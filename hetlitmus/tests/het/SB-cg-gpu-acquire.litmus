Het SB-cg-gpu-acquire
"Heterogeneous SB-cg-gpu-acquire: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X1=x;
0:X2=y;
}
 P0:cpu      | P1:gpu              ;
 MOV W0,#1   | w[relaxed,gpu] y 1  ;
 STR W0,[X1] | r[acquire,gpu] r0 x ;
 LDR W3,[X2] |                     ;
scopes: (sys (gpu (cta P1)))
exists (0:X3=0 /\ 1:r0=0)
