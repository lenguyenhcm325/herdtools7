Het LB-cg-sys-st.ra-2s
"Heterogeneous LB-cg-sys-st.ra-2s: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA)"
{
0:X0=x;
0:X3=y;
}
 P0:cpu      | P1:gpu              ;
 LDR W1,[X0] | r[acquire,sys] r0 y ;
 DMB ST      | w[release,sys] x 1  ;
 MOV W2,#1   |                     ;
 STR W2,[X3] |                     ;
scopes: (sys (gpu (cta P1)))
exists (0:X1=1 /\ 1:r0=1)
