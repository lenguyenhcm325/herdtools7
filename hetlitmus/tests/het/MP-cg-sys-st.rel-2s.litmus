Het MP-cg-sys-st.rel-2s
"Heterogeneous MP-cg-sys-st.rel-2s: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA)"
{
0:X1=x;
0:X3=y;
}
 P0:cpu      | P1:gpu              ;
 MOV W0,#1   | r[relaxed,sys] r0 y ;
 STR W0,[X1] | f[release,sys]      ;
 DMB ST      | r[relaxed,sys] r1 x ;
 MOV W2,#1   |                     ;
 STR W2,[X3] |                     ;
scopes: (sys (gpu (cta P1)))
exists (1:r0=1 /\ 1:r1=0)
