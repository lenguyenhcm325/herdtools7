Het MP-gc-sys-acqrel-2s
"Heterogeneous MP-gc-sys-acqrel-2s: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA)"
{
1:X1=x;
1:X3=y;
}
 P0:gpu             | P1:cpu        ;
 w[release,sys] x 1 | LDAPR W0,[X3] ;
 w[release,sys] y 1 | LDAPR W2,[X1] ;
scopes: (sys (gpu (cta P0)))
exists (1:X0=1 /\ 1:X2=0)
