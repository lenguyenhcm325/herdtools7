Het RWC-gcc-sys-acquire
"Heterogeneous RWC-gcc-sys-acquire: per-proc device assignment gpu,cpu,cpu (cpu=AArch64, gpu=LISA)"
{
1:X0=x;
1:X2=y;
2:X0=x;
}
 P0:gpu              | P1:cpu      | P2:cpu      ;
 r[acquire,sys] r0 x | MOV W1,#1   | MOV W1,#1   ;
 r[acquire,sys] r1 y | STR W1,[X2] | STR W1,[X0] ;
                     | LDR W3,[X0] |             ;
scopes: (sys (gpu (cta P0)))
exists (0:r0=1 /\ 0:r1=0 /\ 1:X3=0)
