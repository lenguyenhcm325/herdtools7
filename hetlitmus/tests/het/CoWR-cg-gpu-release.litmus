Het CoWR-cg-gpu-release
"Heterogeneous CoWR-cg-gpu-release: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA)"
{
0:X1=x;
}
 P0:cpu      | P1:gpu             ;
 MOV W0,#2   | w[release,gpu] x 1 ;
 STR W0,[X1] |                    ;
 LDR W2,[X1] |                    ;
scopes: (sys (gpu (cta P1)))
exists (0:X2=0 /\ [x]=2)
