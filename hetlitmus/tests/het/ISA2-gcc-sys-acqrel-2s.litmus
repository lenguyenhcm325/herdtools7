Het ISA2-gcc-sys-acqrel-2s
"Heterogeneous ISA2-gcc-sys-acqrel-2s: per-proc device assignment gpu,cpu,cpu (cpu=AArch64, gpu=LISA)"
{
1:X3=y;
1:X4=z;
2:X1=x;
2:X4=z;
}
 P0:gpu             | P1:cpu        | P2:cpu        ;
 w[release,sys] x 1 | LDAPR W0,[X3] | LDAPR W0,[X4] ;
 w[release,sys] y 1 | MOV W2,#1     | LDAPR W2,[X1] ;
                    | STLR W2,[X4]  |               ;
scopes: (sys (gpu (cta P0)))
exists (1:X0=1 /\ 2:X0=1 /\ 2:X2=0)
