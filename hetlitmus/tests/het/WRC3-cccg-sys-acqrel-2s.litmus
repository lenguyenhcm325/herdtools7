Het WRC3-cccg-sys-acqrel-2s
"Heterogeneous WRC3-cccg-sys-acqrel-2s: per-proc device assignment cpu,cpu,cpu,gpu (cpu=AArch64, gpu=LISA)"
{
0:X0=x;
0:X3=y;
1:X3=y;
1:X4=z;
2:X0=x;
2:X4=z;
}
 P0:cpu        | P1:cpu        | P2:cpu        | P3:gpu             ;
 LDAPR W1,[X0] | LDAPR W1,[X3] | LDAPR W1,[X4] | w[release,sys] x 1 ;
 MOV W2,#1     | MOV W2,#1     | LDAPR W2,[X0] |                    ;
 STLR W2,[X3]  | STLR W2,[X4]  |               |                    ;
scopes: (sys (gpu (cta P3)))
exists (0:X1=1 /\ 1:X1=1 /\ 2:X1=1 /\ 2:X2=0)
