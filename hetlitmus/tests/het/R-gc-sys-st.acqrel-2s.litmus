Het R-gc-sys-st.acqrel-2s
"Heterogeneous R-gc-sys-st.acqrel-2s: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA)"
{
1:X1=x;
1:X3=y;
}
 P0:gpu             | P1:cpu      ;
 w[relaxed,sys] x 1 | MOV W0,#2   ;
 f[acqrel,sys]      | STR W0,[X3] ;
 w[relaxed,sys] y 1 | DMB ST      ;
                    | LDR W2,[X1] ;
scopes: (sys (gpu (cta P0)))
exists (1:X2=0 /\ [y]=2)
