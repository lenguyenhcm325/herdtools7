Het LB-gc-cta-acquire
"Heterogeneous LB-gc-cta-acquire: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X0=x;
1:X3=y;
}
 P0:gpu              | P1:cpu      ;
 r[acquire,cta] r0 x | LDR W1,[X3] ;
 w[relaxed,cta] y 1  | MOV W2,#1   ;
                     | STR W2,[X0] ;
exists (0:r0=1 /\ 1:X1=1)
