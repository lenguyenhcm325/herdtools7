Het WRC-ccg-sys-fence-2s
"Heterogeneous WRC-ccg-sys-fence-2s: per-proc device assignment cpu,cpu,gpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X0=x;
0:X3=y;
1:X0=x;
1:X3=y;
}
 P0:cpu      | P1:cpu      | P2:gpu             ;
 LDR W1,[X0] | LDR W1,[X3] | w[relaxed,sys] x 1 ;
 DMB SY      | DMB SY      |                    ;
 MOV W2,#1   | LDR W2,[X0] |                    ;
 STR W2,[X3] |             |                    ;
scopes: (sys (gpu (cta P2)))
exists (0:X1=1 /\ 1:X1=1 /\ 1:X2=0)
