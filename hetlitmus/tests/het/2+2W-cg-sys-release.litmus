Het 2+2W-cg-sys-release
"Heterogeneous 2+2W-cg-sys-release: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X1=x;
0:X3=y;
}
 P0:cpu      | P1:gpu             ;
 MOV W0,#2   | w[release,sys] y 2 ;
 STR W0,[X1] | w[release,sys] x 1 ;
 MOV W2,#1   |                    ;
 STR W2,[X3] |                    ;
scopes: (sys (gpu (cta P1)))
exists ([x]=2 /\ [y]=2)
