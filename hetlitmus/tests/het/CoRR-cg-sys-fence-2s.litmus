Het CoRR-cg-sys-fence-2s
"Heterogeneous CoRR-cg-sys-fence-2s: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA)"
{
0:X0=x;
}
 P0:cpu      | P1:gpu             ;
 LDR W1,[X0] | w[relaxed,sys] x 1 ;
 DMB SY      |                    ;
 LDR W2,[X0] |                    ;
scopes: (sys (gpu (cta P1)))
exists (0:X1=1 /\ 0:X2=0)
