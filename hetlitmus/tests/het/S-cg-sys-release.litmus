Het S-cg-sys-release
"Heterogeneous S-cg-sys-release: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X1=x;
0:X3=y;
}
 P0:cpu      | P1:gpu              ;
 MOV W0,#2   | r[relaxed,sys] r0 y ;
 STR W0,[X1] | w[release,sys] x 1  ;
 MOV W2,#1   |                     ;
 STR W2,[X3] |                     ;
exists (1:r0=1 /\ [x]=2)
