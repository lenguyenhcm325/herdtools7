Het ISA2-ccg-sys-acqrel-2s
"Heterogeneous ISA2-ccg-sys-acqrel-2s: per-proc device assignment cpu,cpu,gpu (cpu=AArch64, gpu=LISA)"
{
0:X1=x;
0:X3=y;
1:X3=y;
1:X4=z;
}
 P0:cpu       | P1:cpu        | P2:gpu              ;
 MOV W0,#1    | LDAPR W0,[X3] | r[acquire,sys] r0 z ;
 STLR W0,[X1] | MOV W2,#1     | r[acquire,sys] r1 x ;
 MOV W2,#1    | STLR W2,[X4]  |                     ;
 STLR W2,[X3] |               |                     ;
scopes: (sys (gpu (cta P2)))
exists (1:X0=1 /\ 2:r0=1 /\ 2:r1=0)
