Het ISA2-gcc-gpu-relaxed
"Heterogeneous ISA2-gcc-gpu-relaxed: per-proc device assignment gpu,cpu,cpu (cpu=AArch64, gpu=LISA)"
{
1:X3=y;
1:X4=z;
2:X1=x;
2:X4=z;
}
 P0:gpu             | P1:cpu      | P2:cpu      ;
 w[relaxed,gpu] x 1 | LDR W0,[X3] | LDR W0,[X4] ;
 w[relaxed,gpu] y 1 | MOV W2,#1   | LDR W2,[X1] ;
                    | STR W2,[X4] |             ;
scopes: (sys (gpu (cta P0)))
exists (1:X0=1 /\ 2:X0=1 /\ 2:X2=0)
