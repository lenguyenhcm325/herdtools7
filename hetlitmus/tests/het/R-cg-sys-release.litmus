Het R-cg-sys-release
"Heterogeneous R-cg-sys-release: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X1=x;
0:X3=y;
}
 P0:cpu      | P1:gpu              ;
 MOV W0,#1   | w[release,sys] y 2  ;
 STR W0,[X1] | r[relaxed,sys] r0 x ;
 MOV W2,#1   |                     ;
 STR W2,[X3] |                     ;
exists (1:r0=0 /\ [y]=2)
