Het R-gc-sys-ld.ra-2s
"Heterogeneous R-gc-sys-ld.ra-2s: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA)"
{
1:X1=x;
1:X3=y;
}
 P0:gpu             | P1:cpu      ;
 w[release,sys] x 1 | MOV W0,#2   ;
 w[release,sys] y 1 | STR W0,[X3] ;
                    | DMB LD      ;
                    | LDR W2,[X1] ;
scopes: (sys (gpu (cta P0)))
exists (1:X2=0 /\ [y]=2)
