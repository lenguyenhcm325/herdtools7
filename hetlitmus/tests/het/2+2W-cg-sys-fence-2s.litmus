Het 2+2W-cg-sys-fence-2s
"Heterogeneous 2+2W-cg-sys-fence-2s: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X1=x;
0:X3=y;
}
 P0:cpu      | P1:gpu             ;
 MOV W0,#2   | w[relaxed,sys] y 2 ;
 STR W0,[X1] | f[sc,sys]          ;
 DMB SY      | w[relaxed,sys] x 1 ;
 MOV W2,#1   |                    ;
 STR W2,[X3] |                    ;
scopes: (sys (gpu (cta P1)))
exists ([x]=2 /\ [y]=2)
