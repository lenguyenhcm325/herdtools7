Het WRC-ccg-sys-acqrel-2s
"Heterogeneous WRC-ccg-sys-acqrel-2s: per-proc device assignment cpu,cpu,gpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X0=x;
0:X3=y;
1:X0=x;
1:X3=y;
}
 P0:cpu        | P1:cpu        | P2:gpu             ;
 LDAPR W1,[X0] | LDAPR W1,[X3] | w[release,sys] x 1 ;
 MOV W2,#1     | LDAPR W2,[X0] |                    ;
 STLR W2,[X3]  |               |                    ;
scopes: (sys (gpu (cta P2)))
exists (0:X1=1 /\ 1:X1=1 /\ 1:X2=0)
