Het SB-cg-cta-relaxed
"Heterogeneous SB-cg-cta-relaxed: per-proc device assignment cpu,gpu (cpu=AArch64, gpu=LISA/PTX)"
{
0:X1=x;
0:X2=y;
}
 P0:cpu      | P1:gpu              ;
 MOV W0,#1   | w[relaxed,cta] y 1  ;
 STR W0,[X1] | r[relaxed,cta] r0 x ;
 LDR W3,[X2] |                     ;
exists (0:X3=0 /\ 1:r0=0)
