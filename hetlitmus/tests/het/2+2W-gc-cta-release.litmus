Het 2+2W-gc-cta-release
"Heterogeneous 2+2W-gc-cta-release: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X1=x;
1:X3=y;
}
 P0:gpu             | P1:cpu      ;
 w[release,cta] x 2 | MOV W0,#2   ;
 w[release,cta] y 1 | STR W0,[X3] ;
                    | MOV W2,#1   ;
                    | STR W2,[X1] ;
scopes: (sys (gpu (cta P0)))
exists ([x]=2 /\ [y]=2)
