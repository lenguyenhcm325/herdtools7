Het IRIW-gccc-gpu-acquire
"Heterogeneous IRIW-gccc-gpu-acquire: per-proc device assignment gpu,cpu,cpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X2=y;
2:X0=x;
2:X2=y;
3:X0=x;
}
 P0:gpu              | P1:cpu      | P2:cpu      | P3:cpu      ;
 r[acquire,gpu] r0 x | MOV W1,#1   | LDR W1,[X2] | MOV W1,#1   ;
 r[acquire,gpu] r1 y | STR W1,[X2] | LDR W3,[X0] | STR W1,[X0] ;
exists (0:r0=1 /\ 0:r1=0 /\ 2:X1=1 /\ 2:X3=0)
