Het SB-gc-gpu-fence
"Heterogeneous SB-gc-gpu-fence: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X1=x;
1:X2=y;
}
 P0:gpu              | P1:cpu      ;
 w[relaxed,gpu] x 1  | MOV W0,#1   ;
 f[sc,gpu]           | STR W0,[X2] ;
 r[relaxed,gpu] r0 y | LDR W3,[X1] ;
exists (0:r0=0 /\ 1:X3=0)
