Het CoWR-gc-cta-release
"Heterogeneous CoWR-gc-cta-release: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X1=x;
}
 P0:gpu              | P1:cpu      ;
 w[release,cta] x 2  | MOV W0,#1   ;
 r[relaxed,cta] r0 x | STR W0,[X1] ;
scopes: (sys (gpu (cta P0)))
exists (0:r0=0 /\ [x]=2)
