Het CoRR-gc-gpu-fence
"Heterogeneous CoRR-gc-gpu-fence: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA)"
{
1:X0=x;
}
 P0:gpu              | P1:cpu      ;
 r[relaxed,gpu] r0 x | MOV W1,#1   ;
 f[sc,gpu]           | STR W1,[X0] ;
 r[relaxed,gpu] r1 x |             ;
scopes: (sys (gpu (cta P0)))
exists (0:r0=1 /\ 0:r1=0)
