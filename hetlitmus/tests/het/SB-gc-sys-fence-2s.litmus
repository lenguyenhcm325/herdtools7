Het SB-gc-sys-fence-2s
"Heterogeneous SB-gc-sys-fence-2s: per-proc device assignment gpu,cpu (cpu=AArch64, gpu=LISA/PTX)"
{
1:X1=x;
1:X2=y;
}
 P0:gpu              | P1:cpu      ;
 w[relaxed,sys] x 1  | MOV W0,#1   ;
 f[sc,sys]           | STR W0,[X2] ;
 r[relaxed,sys] r0 y | DMB SY      ;
                     | LDR W3,[X1] ;
scopes: (sys (gpu (cta P0)))
exists (0:r0=0 /\ 1:X3=0)
