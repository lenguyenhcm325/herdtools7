; HetLitmus cram tests (hetlitmus/docs/README-tests.md).  The sandbox
; reconstructs the workspace tree, so deps are the scripts' real relative paths.

; Toolchain-free: pure bash/python, no GPU -- and no %{bin:...}, hence no
; OCaml build.
(cram
 (applies_to basics ptx-negatives)
 (deps
  ../_grid_lib.sh
  ../../verify/ptxcheck.py
  corrupt-strengthen.ptx
  (glob_files ../gpu-only/*.litmus)))

; These emit through litmus7 and read the generated driver.  cpu-stress.t is the
; ONLY check of the stress_go ordering: no gate reads the driver's orchestration.
(cram
 (applies_to pfix-cond coop-launch shared-alloc slot-readout stress cpu-stress
   statistics)
 (package herdtools7)
 (deps
  %{bin:litmus7}
  ; The whole corpus is staged: naming each test here would silently break the
  ; moment one of them read a different row.
  (glob_files ../het/*.litmus)
  ; Every .hip render comes from ../het-x86 -- a HIP harness is (x86_64, hip).
  (glob_files ../het-x86/*)
  ../gpu-only/MP-sys-acquire.litmus))

; gpu-target.t walks up to the source litmus/libdir: dune ignores `_'-prefixed
; dirs, so (source_tree) would stage the top level and NO arch file -- silently.
(cram
 (applies_to gpu-target)
 (package herdtools7)
 (deps
  (universe)   ; that libdir walk is outside the declared deps
  %{bin:litmus7}
  (glob_files ../het/*.litmus)
  (glob_files ../het-x86/*)
  ../gpu-only/MP-sys-acquire.litmus))

; refusals.t writes every test it reads, so litmus7 is its whole toolchain.
(cram
 (applies_to refusals)
 (package herdtools7)
 (deps %{bin:litmus7}))

; no-gpu-proc.t drives hetgen7 as well, which loads its Bell model against herd's
; libdir (stdlib.cat) before it reads -devices.
(cram
 (applies_to no-gpu-proc)
 (package herdtools7)
 (deps
  %{bin:litmus7}
  %{bin:hetgen7}
  ../../bells/gpu.bell
  (source_tree ../../../herd/libdir)))
