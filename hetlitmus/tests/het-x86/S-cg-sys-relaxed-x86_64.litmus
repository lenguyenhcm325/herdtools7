Het S-cg-sys-relaxed-x86_64
"Heterogeneous S-cg-sys-relaxed-x86_64: per-proc device assignment cpu,gpu (cpu=x86_64, gpu=LISA/PTX)"
{
}
 P0:x86_64   | P1:gpu              ;
 movl $2,(x) | r[relaxed,sys] r0 y ;
 movl $1,(y) | w[relaxed,sys] x 1  ;
scopes: (sys (gpu (cta P1)))
exists (1:r0=1 /\ [x]=2)
