"NVIDIA PTX scoped axiomatic model (Lustig'19 transcription)"

(*
 * Transcription of the axiomatic PTX memory model of
 *   [Lustig19] D. Lustig, S. Sahasrabuddhe, O. Giroux, "A Formal Analysis of
 *     the NVIDIA PTX Memory Consistency Model", ASPLOS'19 -- Fig 4 relations
 *     and Fig 7 axioms, over the hetlitmus/bells/ptx.bell vocabulary.
 *   [PTXISA] NVIDIA PTX ISA 9.3, §8.8 "Release and Acquire Patterns",
 *     §9.7.14.4 "membar/fence".
 *
 * It is a SOLVER, not an oracle: its one consumer is verify/ordercheck.py,
 * whose PTX phase decides 96 sys-scope LISA cells so the per-primitive
 * ordering table behind controlmap.py's positive-control lattice meets a
 * model rather than being asserted.  It decides no thesis test and no run
 * path consults it.
 *
 * Two departures from Lustig19, in opposite directions.  Frel/Facq admit
 * f[release,*] and f[acquire,*]: Fig 11 maps onto both, but Fig 3c's modelled
 * fence subset is .sem = {.sc, .acq_rel} and excludes them ([PTXISA] §9.7.14.4
 * dates the qualifiers, PTX ISA 8.6 / sm_90; §8.8 gives them the pattern
 * positions used here).  Neither set admits f[acq_rel,*], which Lustig19 has
 * in both; no test carries one.  Fidelity record, with the specialisations
 * vacuous for this vocabulary: hetlitmus/docs/nvidia-ptx-cat.md §3 and §5.
 *)

(* ================================================================== *)
(* Communication. cos.cat generates co (off by default for bell       *)
(* models) and derives fr.  The axioms below relate rf, co and fr     *)
(* through morally_strong, never through an external projection.      *)
(* ================================================================== *)
include "cos.cat"

(* ================================================================== *)
(* Annotation event sets, from ptx.bell tags via tag2events.          *)
(* memory-order lattice (ptx.bell): relaxed < {acquire,release} <     *)
(* acq_rel < sc, so f[sc,*] is both a release and an acquire fence.   *)
(* ================================================================== *)
let REL = tag2events('release)
let ACQ = tag2events('acquire)
let SCo = tag2events('sc)

let CTA = tag2events('cta)
let GPUscope = tag2events('gpu)
let SYS = tag2events('sys)

let Wrel = W & (REL | SCo)        (* W^{>=REL} : release (or sc) write     *)
let Racq = R & (ACQ | SCo)        (* R^{>=ACQ} : acquire (or sc) read      *)
let Frel = F & (REL | SCo)        (* F^{>=REL} : fence.release, fence.sc   *)
let Facq = F & (ACQ | SCo)        (* F^{>=ACQ} : fence.acquire, fence.sc   *)
let FSC  = F & SCo                (* fence.sc                              *)

let MEM = R | W

(* ================================================================== *)
(* MORAL STRENGTH (Lustig19 §3.3).  A pair is morally strong iff each  *)
(*  op is strong (every scoped op here is; none are .weak), each op's  *)
(*  scope encompasses the other's thread, and -- if both are memory    *)
(*  ops -- they overlap; program-order-related pairs count too.        *)
(*                                                                     *)
(*  enc(e1,e2): e1's own scope-instance contains thread(e2). With one  *)
(*  scope tag per event, enc = union over levels of [tagged-at-S];     *)
(*  tag2scope(S), which reads the test's own `scopes:' tree; mutual =  *)
(*  enc & enc^-1 = "each encompasses the other".                       *)
(* ================================================================== *)
let enc = ([CTA] ; tag2scope('cta))
        | ([GPUscope] ; tag2scope('gpu))
        | ([SYS] ; tag2scope('sys))
let mutual = enc & (enc^-1)

(* mem-mem pairs require overlap (loc); pairs involving a fence do not;  *)
(* program-order-related pairs are morally strong too.                  *)
let ms = (mutual & loc & (MEM * MEM))
       | ([F] ; mutual)
       | (mutual ; [F])
       | po | (po^-1)

(* ================================================================== *)
(* FENCE-SC ORDER (Lustig19 §3.4.3 / Fig 7 Axiom 2).                    *)
(*  sc = an acyclic order relating every pair of morally-strong         *)
(*  fence.sc ops, determined at runtime. Encoded the herd way: let the  *)
(*  tool enumerate total orders of the fence.sc events, then keep only  *)
(*  the morally-strong pairs (so under a scopes: tree that puts each    *)
(*  proc in its own CTA, cta-scope fences leave sc empty).              *)
(* ================================================================== *)
with sc_tot from linearisations(FSC, 0)
let sc = sc_tot & ms

(* ================================================================== *)
(* PTX RELATIONS (Lustig19 Fig 4).                                      *)
(* ================================================================== *)
let pol = po & loc                                   (* po_loc *)

let pattern_rel = ([Wrel] ; pol? ; [W]) | ([Frel] ; po ; [W])
let pattern_acq = ([R] ; pol? ; [Racq]) | ([R] ; po ; [Facq])

(* obs := (morally_strong & rf) | (obs;rmw;obs).  ptx.bell declares no    *)
(* read-modify-write instruction, so rmw is empty and the fixpoint is     *)
(* just the base term -- obs;rmw;obs contributes nothing.                 *)
let obs = ms & rf

let sync_barrier = 0                       (* ptx.bell has no bar.sync *)

let sw = (ms & (pattern_rel ; obs ; pattern_acq)) | sync_barrier | sc
let cause_base = (po? ; sw ; po?)+
let cause = cause_base | (obs ; (cause_base | pol))

(* ================================================================== *)
(* PTX AXIOMS (Lustig19 Fig 7).                                         *)
(* ================================================================== *)

(* Axiom 1 Coherence: [W];cause;[W] subset co.  PTX co relates the pairs *)
(* that OVERLAP (Lustig19 §3.5.1) and herd's co is per-location, so the  *)
(* cause-ordered write pairs are restricted to same-loc ones.            *)
let coherence_req = ([W] ; cause ; [W]) & loc
empty (coherence_req \ co) as coherence

(* Axiom 2 FenceSC *)
irreflexive (sc ; cause) as fence_sc

(* Axiom 3 Atomicity (rmw is empty here -> vacuous; transcribed anyway) *)
empty (((ms & fr) ; (ms & co)) & rmw) as atomicity

(* Axiom 4 No-Thin-Air: acyclic(rf | dep).  herd binds no `dep' for a    *)
(* Bell model, so the line is forced, not chosen; diy emits no dependency *)
(* edge here, which is what makes 0 the faithful binding.                *)
let dep = 0
acyclic (rf | dep) as no_thin_air

(* Axiom 5 SC-per-Location *)
acyclic ((ms & (rf | co | fr)) | pol) as sc_per_location

(* Axiom 6 Causality *)
irreflexive ((rf | fr) ; cause) as causality
