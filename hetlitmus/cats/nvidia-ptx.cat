"NVIDIA PTX scoped axiomatic model (HetLitmus GPU-only oracle, NVIDIA side)"

(*
 * Axiomatic (herd7) model for the HetLitmus GPU-only litmus corpus, targeting
 * the NVIDIA Hopper GPU = the *pure scoped PTX memory model*. Pairs with
 * hetlitmus/bells/ptx.bell. This is the NVIDIA counterpart to amd-gcn3.cat;
 * the .litmus files are vendor-neutral and shared, only the verdicts differ.
 *
 * GOAL: machine-check hetlitmus/tests/gpu-only/expected-nvidia.csv (all 137
 * GPU-only tests), and reproduce the 8 hand-derived PLDI'23-anchored verdicts
 * (MP-sys, MP-sys-F, MP-cta-F, LB-sys, SB-sys, SB-sys-F, IRIW-sys, IRIW-sys-F).
 *
 * ============================ SOURCE / AUTHORITY ============================
 * This model is a DIRECT, LINE-BY-LINE encoding of the formal axiomatic PTX
 * memory model of:
 *   [Lustig19] D. Lustig, S. Sahasrabuddhe, O. Giroux, "A Formal Analysis of
 *     the NVIDIA PTX Memory Consistency Model", ASPLOS'19.
 *       - Fig 4  : the PTX relations (pattern_rel, obs, pattern_acq, sw,
 *                  cause_base, cause).
 *       - Fig 7  : the SIX top-level axioms (Coherence, FenceSC, Atomicity,
 *                  No-Thin-Air, SC-per-Location, Causality).
 *       - Fig 5  : release/acquire synchronisation forbids MP (§3.4.1).
 *       - Fig 6  : preventing store buffering (SB) REQUIRES a morally-strong
 *                  fence.sc on each thread -- acquire/release ALONE cannot
 *                  prevent SB (§3.4.3). This is the headline vendor difference
 *                  from AMD-GCN3 (where sys rel/acq is an HRF cache flush).
 *       - §3.3   : "strong" operation and "morally strong" (mutually
 *                  scope-encompassing) -- the synchronisation eligibility test.
 *       - §3.4   : "The PTX model is not multi-copy atomic" -> rel/acq on the
 *                  IRIW readers does NOT forbid IRIW (needs a fence.sc).
 *
 * AUTHORITY FINDING (grounded, see hetlitmus/docs/nvidia-ptx-cat.md): Lustig19
 * is the canonical axiomatic formalisation, and it formalises the OFFICIAL
 * NVIDIA PTX ISA memory-model chapter (PTX ISA Chapter 8: "morally strong",
 * §8.7 release/acquire patterns, §8.8 fence-SC order, §8.9 axioms Coherence
 * /Atomicity/No-Thin-Air/SC-per-Location/Causality). The current PTX ISA (9.x)
 * still carries the same chapter; Lustig19 is NOT superseded. The only later
 * formalisation, "Mixed-Proxy Extensions for the NVIDIA PTX MCM" (ISCA'22),
 * ADDS texture/surface/constant proxy handling, irrelevant to this single
 * (generic global-memory) proxy corpus. Empirical confirmation on real Hopper
 * silicon: [Bagchi26] ISMM'26 §3.2 (moral strength = mutual scope
 * encompassment), §4.1 (morally-strong gpu+ rel/acq => no weak MP; one-sided /
 * cta-scope => weak observed), §2.1/§4 (PTX is non-MCA).
 *
 * ============================ SCOPE ENCODING ===============================
 * Identical machinery to amd-gcn3.cat: herd builds true scope-instance
 * structure (tag2scope) from the parseable `scopes: (sys (gpu (cta P0) ...))'
 * tree the corpus carries. Each proc sits in its own CTA, all CTAs under one
 * GPU under one SYS, so:
 *   - cta-scope ops on different procs are in DIFFERENT CTAs  -> NOT morally
 *     strong  -> no cross-thread synchronisation (this is why MP-cta-F is
 *     Allowed: Lustig19 §3.3 / Bagchi26 Fig 2e).
 *   - gpu/sys-scope ops share their instance -> morally strong.
 *
 * ====================== WHAT THE VENDOR DIFFERENCE IS =======================
 * vs amd-gcn3.cat, this model has NO `load-store' (LB) acyclicity and NO
 * `sys-strong' flush axiom. PTX rel/acq is pure scoped ORDERING (a
 * synchronizes-with that needs an actual morally-strong rf to observe), NOT an
 * AMD-style heavyweight system flush. Consequences the axioms below produce:
 *   - LB-sys (relaxed)  : Allowed   (No-Thin-Air = acyclic(rf|dep), no dep).
 *   - SB-sys-F (rel/acq): Allowed   (both readers read init -> no rf to
 *                                    observe -> sw never fires; Fig 6 needs
 *                                    fence.sc).
 *   - IRIW-sys-F        : Allowed   (non-MCA; rel/acq orders each reader's
 *                                    loads but cannot force one write order).
 *   - *-fence at gpu/sys: Forbidden (morally-strong fence.sc => sc order =>
 *                                    Causality/FenceSC cut every cycle).
 *)

(* ================================================================== *)
(* Communication. cos.cat generates co (off by default for bell       *)
(* models) and derives fr.  The axioms below relate rf, co and fr     *)
(* through morally_strong, never through an external projection.      *)
(* ================================================================== *)
include "cos.cat"

(* ================================================================== *)
(* Annotation event sets, from ptx.bell tags via tag2events.          *)
(* memory-order lattice (ptx.bell): relaxed < {acquire,release} <      *)
(* acq_rel < sc.  A fence.sc (corpus fences are f[sc,<scope>]) is BOTH *)
(* a release fence and an acquire fence (sc >= rel and sc >= acq).     *)
(* ================================================================== *)
let REL = tag2events('release)
let ACQ = tag2events('acquire)
let SCo = tag2events('sc)

let CTA = tag2events('cta)
let GPUscope = tag2events('gpu)
let SYS = tag2events('sys)

let Wrel = W & (REL | SCo)        (* W^{>=REL} : release (or sc) write     *)
let Racq = R & (ACQ | SCo)        (* R^{>=ACQ} : acquire (or sc) read      *)
let Frel = F & (REL | SCo)        (* F^{>=REL} : release fence (fence.sc)  *)
let Facq = F & (ACQ | SCo)        (* F^{>=ACQ} : acquire fence (fence.sc)  *)
let FSC  = F & SCo                (* fence.sc                              *)

let MEM = R | W

(* ================================================================== *)
(* MORAL STRENGTH (Lustig19 §3.3 / Bagchi26 §3.2).                      *)
(*  A pair is morally strong iff each op is strong (here every scoped   *)
(*  op is, none are .weak) AND each op's scope encompasses the thread   *)
(*  of the other AND, if both are memory ops, they overlap (same addr); *)
(*  also any two program-order-related ops are morally strong.          *)
(*                                                                       *)
(*  enc(e1,e2): e1's own scope-instance contains thread(e2). With one   *)
(*  scope tag per event, enc = union over levels of [tagged-at-S];      *)
(*  tag2scope(S). mutual = enc & enc^-1 = "each encompasses the other". *)
(* ================================================================== *)
let enc = ([CTA] ; tag2scope('cta))
        | ([GPUscope] ; tag2scope('gpu))
        | ([SYS] ; tag2scope('sys))
let mutual = enc & (enc^-1)

(* mem-mem pairs require overlap (loc); pairs involving a fence do not;  *)
(* program-order-related pairs are morally strong too.                  *)
let ms = (mutual & loc & (MEM * MEM))
       | ([F] ; mutual)
       | (mutual ; [F])
       | po | (po^-1)

(* ================================================================== *)
(* FENCE-SC ORDER (Lustig19 §3.4.3 / Fig 7 Axiom 2).                    *)
(*  sc = an acyclic order relating every pair of morally-strong         *)
(*  fence.sc ops, determined at runtime. Encoded the herd way: let the  *)
(*  tool enumerate total orders of the fence.sc events, then keep only  *)
(*  the morally-strong pairs (so at cta scope, where fences sit in       *)
(*  different CTAs and are NOT morally strong, sc is empty).            *)
(* ================================================================== *)
with sc_tot from linearisations(FSC, 0)
let sc = sc_tot & ms

(* ================================================================== *)
(* PTX RELATIONS (Lustig19 Fig 4).                                      *)
(* ================================================================== *)
let pol = po & loc                                   (* po_loc *)

let pattern_rel = ([Wrel] ; pol? ; [W]) | ([Frel] ; po ; [W])
let pattern_acq = ([R] ; pol? ; [Racq]) | ([R] ; po ; [Facq])

(* obs := (morally_strong & rf) | (obs;rmw;obs).  rmw = {} in this       *)
(* corpus (no atomic read-modify-writes), so the fixpoint is just the    *)
(* base term -- obs;rmw;obs contributes nothing.                         *)
let obs = ms & rf

let sync_barrier = 0                                 (* no bar.sync in corpus *)

let sw = (ms & (pattern_rel ; obs ; pattern_acq)) | sync_barrier | sc
let cause_base = (po? ; sw ; po?)+
let cause = cause_base | (obs ; (cause_base | pol))

(* ================================================================== *)
(* PTX AXIOMS (Lustig19 Fig 7).                                         *)
(* ================================================================== *)

(* Axiom 1 Coherence: [W];cause;[W] subset co. co is per-location, so    *)
(* restrict the cause-ordered write pairs to overlapping (same-loc) ones.*)
let coherence_req = ([W] ; cause ; [W]) & loc
empty (coherence_req \ co) as coherence

(* Axiom 2 FenceSC *)
irreflexive (sc ; cause) as fence_sc

(* Axiom 3 Atomicity (rmw = {} here -> vacuous, kept for faithfulness) *)
empty (((ms & fr) ; (ms & co)) & rmw) as atomicity

(* Axiom 4 No-Thin-Air: acyclic(rf | dep). diy generates no dependencies *)
(* for this corpus, so dep = {} and this never constrains (LB Allowed).  *)
let dep = 0
acyclic (rf | dep) as no_thin_air

(* Axiom 5 SC-per-Location *)
acyclic ((ms & (rf | co | fr)) | pol) as sc_per_location

(* Axiom 6 Causality *)
irreflexive ((rf | fr) ; cause) as causality
