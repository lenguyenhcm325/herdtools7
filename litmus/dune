(rule
 (copy ../Version.ml Version.ml))

; HetLitmus: generate the HetPayloads module -- the C/CUDA runtime sources the
; het emitter writes VERBATIM into every emitted harness dir (top_litmus.ml,
; `write' calls in the Het arm).  The payloads are real files under
; het-runtime/ (editable with C tooling; design notes in het-runtime/README.md)
; and are wrapped into OCaml string literals here at build time, so the string
; can never drift from the file.  outs.{h,c} are litmus7's OWN histogram: they
; are cat'ed straight from libdir/_outs.{h,c}, which makes the old
; comment-enforced invariant "keep byte-identical to libdir" hold by
; construction.  If a payload ever contains the raw-string delimiter
; `|het_payload}' the generated module fails to compile -- loud, not silent.
(rule
 (targets hetPayloads.ml)
 (deps libdir/_outs.h libdir/_outs.c
       het-runtime/het_stress.cuh
       het-runtime/het_cpu_stress.h
       het-runtime/het_verdict.h)
 (action
  (with-stdout-to hetPayloads.ml
   (progn
    (echo "(* GENERATED by the hetPayloads rule in litmus/dune -- DO NOT EDIT.\n")
    (echo "   Edit the sources instead: litmus/libdir/_outs.{h,c} (outs_h/outs_c)\n")
    (echo "   and litmus/het-runtime/* (the het runtime headers). *)\n\n")
    (echo "let outs_h = {het_payload|")
    (cat libdir/_outs.h)
    (echo "|het_payload}\n\n")
    (echo "let outs_c = {het_payload|")
    (cat libdir/_outs.c)
    (echo "|het_payload}\n\n")
    (echo "let het_stress_cuh = {het_payload|")
    (cat het-runtime/het_stress.cuh)
    (echo "|het_payload}\n\n")
    (echo "let het_cpu_stress_h = {het_payload|")
    (cat het-runtime/het_cpu_stress.h)
    (echo "|het_payload}\n\n")
    (echo "let het_verdict_h = {het_payload|")
    (cat het-runtime/het_verdict.h)
    (echo "|het_payload}\n")))))

