;; do not ignore dirs starting with _

(subdir
 libdir
 (data_only_dirs *))

(rule
 (copy ../Version.ml Version.ml))

; HetLitmus: wrap the C/CUDA runtime payloads a harness carries into the
; generated HetPayloads module, read by hetEmit.ml and hetDialect.ml.  What the
; payloads are, and the `|het_payload}' delimiter constraint on their content:
; litmus/het-runtime/README.md.
(rule
 (targets hetPayloads.ml)
 (deps libdir/_outs.h libdir/_outs.c
       het-runtime/het_stress.h
       het-runtime/het_cpu_stress.h
       het-runtime/het_verdict.h
       het-runtime/het_rdv.h
       het-runtime/het_alloc_cuda.inc
       het-runtime/het_noise_cuda.inc
       het-runtime/het_alloc_hip.inc
       het-runtime/het_noise_hip.inc)
 (action
  (with-stdout-to hetPayloads.ml
   (progn
    (echo "(* GENERATED by the hetPayloads rule in litmus/dune -- DO NOT EDIT.\n")
    (echo "   Edit the sources instead: litmus/libdir/_outs.{h,c} (outs_h/outs_c)\n")
    (echo "   and litmus/het-runtime/* (the het runtime headers). *)\n\n")
    (echo "let outs_h = {het_payload|")
    (cat libdir/_outs.h)
    (echo "|het_payload}\n\n")
    (echo "let outs_c = {het_payload|")
    (cat libdir/_outs.c)
    (echo "|het_payload}\n\n")
    (echo "let het_stress_h = {het_payload|")
    (cat het-runtime/het_stress.h)
    (echo "|het_payload}\n\n")
    (echo "let het_cpu_stress_h = {het_payload|")
    (cat het-runtime/het_cpu_stress.h)
    (echo "|het_payload}\n\n")
    (echo "let het_verdict_h = {het_payload|")
    (cat het-runtime/het_verdict.h)
    (echo "|het_payload}\n\n")
    (echo "let het_rdv_h = {het_payload|")
    (cat het-runtime/het_rdv.h)
    (echo "|het_payload}\n\n")
    (echo "let het_alloc_cuda_inc = {het_payload|")
    (cat het-runtime/het_alloc_cuda.inc)
    (echo "|het_payload}\n\n")
    (echo "let het_noise_cuda_inc = {het_payload|")
    (cat het-runtime/het_noise_cuda.inc)
    (echo "|het_payload}\n\n")
    (echo "let het_alloc_hip_inc = {het_payload|")
    (cat het-runtime/het_alloc_hip.inc)
    (echo "|het_payload}\n\n")
    (echo "let het_noise_hip_inc = {het_payload|")
    (cat het-runtime/het_noise_hip.inc)
    (echo "|het_payload}\n")))))

